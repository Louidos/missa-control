# Missa Control – Einstellungen
#
# Diese Datei ist nur ein Beispiel. Die echte Datei heisst `.env`, liegt im selben Ordner
# und wird nie ins Repo eingecheckt. `./scripts/install.sh` erzeugt sie automatisch
# (mit zufälligen Schlüsseln) und überschreibt eine vorhandene `.env` nie.

# ---------- Erreichbarkeit ----------

# Adresse und Port, unter denen das Panel auf ai01 erreichbar ist.
# Standard: alle Adressen, Port 8090. Nur von ai01 selbst erreichbar: 127.0.0.1:8090
MISSA_CONTROL_BIND=0.0.0.0:8090

# ---------- Geräte (ESP32, Raspberry Pi Pico) ----------

# Adresse und Port des MQTT-Brokers, über den sich Geräte verbinden.
# Standard: alle Adressen, Port 1883. In der Firewall nur für das Geräte-Netz freigeben.
MQTT_BIND=0.0.0.0:1883

# Schaltet den MQTT-Broker ein. Ohne Geräte: COMPOSE_PROFILES= (leer) – dann startet er nicht.
COMPOSE_PROFILES=geraete

# ---------- Schlüssel (erzeugt install.sh, bitte nicht von Hand ändern) ----------

# Schützt Sitzungen und Tokens. Wird er geändert, sind alle Anmeldungen und Tokens ungültig.
SECRET_KEY=

# Verschlüsselt gespeicherte Geheimnisse (Fernet-Schlüssel). Geht er verloren, sind die
# gespeicherten Geheimnisse nicht mehr lesbar – deshalb gehört `.env` in jedes Backup.
ENCRYPTION_KEY=

# ---------- Container-Benutzer (setzt install.sh) ----------

# Benutzer- und Gruppen-ID, unter denen das Panel im Container läuft (nie root).
# Der Ordner `data/` muss diesem Benutzer gehören.
MISSA_CONTROL_UID=
MISSA_CONTROL_GID=

# ---------- Zeit (übernimmt install.sh von ai01, falls dort eine Zeitzone eingestellt ist) ----------

# Zeitzone für Uhrzeiten in Regeln („jeden Tag um 07:30“) und Ruhezeiten,
# z. B. Europe/Zurich, Europe/Berlin oder Europe/Vienna.
MISSA_CONTROL_ZEITZONE=Europe/Zurich

# ---------- Optional ----------

# Health-Adresse von missa-core, z. B. http://host.docker.internal:8000/health oder
# http://192.168.1.10:8000/health (nicht 127.0.0.1 – das Panel läuft in einem eigenen Container).
# Das Panel ruft sie nur lesend ab (HTTP-GET) und zeigt in der Übersicht, ob Missa läuft.
# Leer: missa-core wird nicht abgefragt, der Knoten „Missa“ bleibt grau.
#MISSA_CORE_HEALTH_URL=

# Sitzungs-Cookie nur über HTTPS senden: auto (Standard), ja oder nein.
# "auto" setzt die Einschränkung genau dann, wenn das Panel über HTTPS aufgerufen wird.
#MISSA_CONTROL_COOKIE_SECURE=auto

# GPU-Werte auf der Seite „Serverlast“ (nur mit NVIDIA-GPU und NVIDIA Container Toolkit auf ai01).
# Ohne diese Zeile – oder ohne GPU – werden die GPU-Werte einfach ausgeblendet.
#COMPOSE_FILE=compose.yaml:config/compose.gpu.yaml
